APP_NAME="NTB Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://tbt.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tbtsystem
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=mailtrap
MAIL_FROM_ADDRESS="noreply@ntb.local"
MAIL_FROM_NAME="${APP_NAME}"

# Mailtrap Email Sandbox (API) — https://mailtrap.io
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=425599
MAILTRAP_SANDBOX=true

VITE_APP_NAME="${APP_NAME}"

# Email OTP (MFA) requires a working mailer (e.g. Mailtrap above)
NTB_MFA_ENABLED=true
